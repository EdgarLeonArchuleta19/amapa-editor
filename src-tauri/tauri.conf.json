{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AMAPA",
  "version": "1.0.0",
  "identifier": "com.edgarleon.amapa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AMAPA | Editor de Video",
        "width": 1440,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#08080a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Edgar Leon Archuleta",
    "copyright": "Copyright (c) 2026 Edgar Leon Archuleta. MIT License.",
    "category": "Video",
    "shortDescription": "AMAPA — Editor de Video Nativo y Minimalista",
    "longDescription": "AMAPA es un editor de video nativo para Windows construido con Rust y Tauri 2. Ultra liviano, sin marcas de agua y 100% local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
